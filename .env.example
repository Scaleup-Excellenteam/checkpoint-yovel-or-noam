# TSPO Chat settings.
#
# Copy this file to .env and edit the values you need:
#
#   cp .env.example .env
#
# .env is ignored by Git, so it never reaches GitHub. A value already exported
# in PowerShell, bash, or a systemd unit wins over the value written here, so
# this file sets defaults rather than overriding a real deployment.
# Restart the server after editing.

# ---------------------------------------------------------------------------
# How many people the server accepts
# ---------------------------------------------------------------------------

# Total chat connections at the same time.
CHAT_MAX_CONNECTIONS=100

# Connections allowed from one address. Two browser tabs count as two.
CHAT_MAX_CONNECTIONS_PER_IP=5

# ---------------------------------------------------------------------------
# Speed limits
# ---------------------------------------------------------------------------

# Messages one client may send inside CHAT_MESSAGE_WINDOW_SECONDS. Going over
# closes that connection.
CHAT_MAX_MESSAGES_PER_WINDOW=20
CHAT_MESSAGE_WINDOW_SECONDS=10

# Login attempts allowed from one address per CHAT_LOGIN_WINDOW_SECONDS.
CHAT_MAX_LOGIN_ATTEMPTS_PER_WINDOW=5
CHAT_LOGIN_WINDOW_SECONDS=60

# New accounts allowed from one address per CHAT_SIGNUP_WINDOW_SECONDS.
# The default is 3 per hour.
CHAT_MAX_SIGNUPS_PER_WINDOW=3
CHAT_SIGNUP_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------------
# Messages and sessions
# ---------------------------------------------------------------------------

# Longest chat message. Must stay below 4096, the WebSocket frame limit.
CHAT_MAX_MESSAGE_LENGTH=500

# Blocked messages allowed before the connection is closed.
CHAT_MAX_DLP_VIOLATIONS=3

# How long a login stays valid, in seconds. The default is one hour.
CHAT_TOKEN_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# 127.0.0.1 accepts only this computer. Use 0.0.0.0 for the two-computer demo,
# and keep 127.0.0.1 when a TLS proxy sits in front.
CHAT_BIND_HOST=127.0.0.1

# Extra addresses the browser UI may be opened from, separated by commas.
# CHAT_WEB_HOSTS=192.168.1.20

# Set both of these only when running behind a TLS reverse proxy.
# See "Publishing On The Internet" in README.md.
# CHAT_PUBLIC_ORIGIN=https://chat.example.com
# CHAT_TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Without this key Anti-Bot records REPUTATION_UNAVAILABLE and allows every
# public address, so the check does nothing.
VIRUSTOTAL_API_KEY=

# Passwords, username rules, and the password hashing cost are deliberately not
# settings. Changing them weakens how accounts are protected, so they live in
# server/server.py and should go through a code review.
